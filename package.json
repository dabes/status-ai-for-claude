{
  "name": "status-ai-for-claude",
  "displayName": "Status AI for Claude",
  "description": "Unofficial. Plan usage (5-hour and weekly limits), what each Claude Code session is running (foreground and background, with progress) and AI Usage: tokens and cost per day, project, model and tool.",
  "version": "0.6.3",
  "publisher": "xpree",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "claude code",
    "background tasks",
    "agents",
    "progress",
    "dashboard",
    "usage",
    "cost",
    "tokens"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "aiStatus",
          "title": "%aiStatus.container%",
          "icon": "$(pulse)"
        },
        {
          "id": "aiUsage",
          "title": "%aiUsage.container%",
          "icon": "$(graph)"
        }
      ]
    },
    "views": {
      "aiStatus": [
        {
          "id": "aiStatus.view",
          "name": "%aiStatus.view%"
        }
      ],
      "aiUsage": [
        {
          "id": "aiStatus.usage",
          "name": "%aiStatus.usage%"
        }
      ]
    },
    "commands": [
      {
        "command": "aiStatus.reload",
        "title": "%cmd.reload%",
        "icon": "$(refresh)"
      },
      {
        "command": "aiStatus.openBrowser",
        "title": "%cmd.openBrowser%",
        "icon": "$(link-external)"
      },
      {
        "command": "aiStatus.reloadUsage",
        "title": "%cmd.reloadUsage%",
        "icon": "$(refresh)"
      },
      {
        "command": "aiStatus.openUsage",
        "title": "%cmd.openUsage%",
        "icon": "$(graph-line)"
      }
    ],
    "configuration": {
      "title": "Status AI for Claude",
      "properties": {
        "aiStatus.python": {
          "type": "string",
          "default": "",
          "description": "%cfg.python%"
        },
        "aiStatus.port": {
          "type": "number",
          "default": 8765,
          "description": "%cfg.port%"
        },
        "aiStatus.days": {
          "type": "number",
          "default": 3,
          "description": "%cfg.days%"
        },
        "aiStatus.usageDays": {
          "type": "number",
          "default": 30,
          "description": "%cfg.usageDays%"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "aiStatus.reload",
          "when": "view == aiStatus.view",
          "group": "navigation"
        },
        {
          "command": "aiStatus.openBrowser",
          "when": "view == aiStatus.view",
          "group": "navigation"
        },
        {
          "command": "aiStatus.reloadUsage",
          "when": "view == aiStatus.usage",
          "group": "navigation"
        },
        {
          "command": "aiStatus.openUsage",
          "when": "view == aiStatus.usage",
          "group": "navigation"
        }
      ]
    }
  }
}
