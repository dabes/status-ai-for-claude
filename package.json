{
  "name": "status-ai-for-claude",
  "displayName": "Status AI for Claude",
  "description": "See how much of your Claude Code 5-hour and weekly limits is left, and what every session, command and subagent is running, with progress. Plus tokens and cost per day, project and model. Unofficial.",
  "version": "0.8.0",
  "publisher": "xpree",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f1f1d",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dabes/status-ai-for-claude"
  },
  "homepage": "https://github.com/dabes/status-ai-for-claude#readme",
  "bugs": {
    "url": "https://github.com/dabes/status-ai-for-claude/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "rate limit",
    "usage limit",
    "plan usage",
    "token usage",
    "cost",
    "tokens",
    "subagents",
    "agents",
    "background tasks",
    "progress",
    "dashboard",
    "usage"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "aiStatus",
          "title": "%aiStatus.container%",
          "icon": "$(pulse)"
        },
        {
          "id": "aiUsage",
          "title": "%aiUsage.container%",
          "icon": "$(graph)"
        }
      ]
    },
    "views": {
      "aiStatus": [
        {
          "id": "aiStatus.view",
          "name": "%aiStatus.view%"
        }
      ],
      "aiUsage": [
        {
          "id": "aiStatus.usage",
          "name": "%aiStatus.usage%"
        }
      ]
    },
    "commands": [
      {
        "command": "aiStatus.reload",
        "title": "%cmd.reload%",
        "icon": "$(refresh)"
      },
      {
        "command": "aiStatus.openBrowser",
        "title": "%cmd.openBrowser%",
        "icon": "$(link-external)"
      },
      {
        "command": "aiStatus.reloadUsage",
        "title": "%cmd.reloadUsage%",
        "icon": "$(refresh)"
      },
      {
        "command": "aiStatus.openUsage",
        "title": "%cmd.openUsage%",
        "icon": "$(graph-line)"
      }
    ],
    "configuration": {
      "title": "Status AI for Claude",
      "properties": {
        "aiStatus.port": {
          "type": "number",
          "default": 8765,
          "description": "%cfg.port%"
        },
        "aiStatus.days": {
          "type": "number",
          "default": 3,
          "description": "%cfg.days%"
        },
        "aiStatus.usageDays": {
          "type": "number",
          "default": 30,
          "description": "%cfg.usageDays%"
        },
        "aiStatus.notify.waiting": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.notify.waiting%"
        },
        "aiStatus.notify.tasks": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.notify.tasks%"
        },
        "aiStatus.notify.limit": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.notify.limit%"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "aiStatus.reload",
          "when": "view == aiStatus.view",
          "group": "navigation"
        },
        {
          "command": "aiStatus.openBrowser",
          "when": "view == aiStatus.view",
          "group": "navigation"
        },
        {
          "command": "aiStatus.reloadUsage",
          "when": "view == aiStatus.usage",
          "group": "navigation"
        },
        {
          "command": "aiStatus.openUsage",
          "when": "view == aiStatus.usage",
          "group": "navigation"
        }
      ]
    }
  }
}
