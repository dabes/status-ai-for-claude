{
  "name": "status-ai-for-claude",
  "displayName": "Status AI for Claude",
  "description": "Unofficial. Plan usage (5-hour and weekly limits), what each Claude Code session is running (foreground and background, with progress) and AI Usage: tokens and cost per day, project, model and tool.",
  "version": "0.5.0",
  "publisher": "xpree",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "claude code",
    "background tasks",
    "agents",
    "progress",
    "dashboard",
    "usage",
    "cost",
    "tokens"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "aiStatus",
          "title": "AI Status",
          "icon": "$(pulse)"
        },
        {
          "id": "aiUsage",
          "title": "AI Usage",
          "icon": "$(graph)"
        }
      ]
    },
    "views": {
      "aiStatus": [
        {
          "id": "aiStatus.view",
          "name": "AI Status"
        }
      ],
      "aiUsage": [
        {
          "id": "aiStatus.usage",
          "name": "AI Usage"
        }
      ]
    },
    "commands": [
      {
        "command": "aiStatus.reload",
        "title": "AI Status: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "aiStatus.openBrowser",
        "title": "AI Status: Open in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "aiStatus.reloadUsage",
        "title": "AI Usage: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "aiStatus.openUsage",
        "title": "AI Usage: Open Charts",
        "icon": "$(graph-line)"
      }
    ],
    "configuration": {
      "title": "Status AI for Claude",
      "properties": {
        "aiStatus.python": {
          "type": "string",
          "default": "",
          "description": "Python 3 executable used to run the panel server. Empty: \"python\" on Windows, \"python3\" elsewhere."
        },
        "aiStatus.port": {
          "type": "number",
          "default": 8765,
          "description": "Local port of the panel server (127.0.0.1 only)."
        },
        "aiStatus.days": {
          "type": "number",
          "default": 3,
          "description": "How many days of Claude Code sessions to scan for background tasks."
        },
        "aiStatus.usageDays": {
          "type": "number",
          "default": 30,
          "description": "How many days of Claude Code history the AI Usage tab sums (tokens and cost)."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "aiStatus.reload",
          "when": "view == aiStatus.view",
          "group": "navigation"
        },
        {
          "command": "aiStatus.openBrowser",
          "when": "view == aiStatus.view",
          "group": "navigation"
        },
        {
          "command": "aiStatus.reloadUsage",
          "when": "view == aiStatus.usage",
          "group": "navigation"
        },
        {
          "command": "aiStatus.openUsage",
          "when": "view == aiStatus.usage",
          "group": "navigation"
        }
      ]
    }
  }
}
